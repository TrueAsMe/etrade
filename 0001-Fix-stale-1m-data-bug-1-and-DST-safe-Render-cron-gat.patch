+"""Shared fixtures: fake Databento Historical + Live network layers.
+
+Records are REAL databento_dbn classes (OHLCVMsg / SystemMsg / ErrorMsg) so
+data_feed's isinstance dispatch and fixed-point price scaling are exercised
+exactly as in production. Only the sockets/HTTP are replaced.
+
+The fake market trades every minute and a bar's prices are a pure function of
+its open time, so Historical and Live agree on overlap (as verified against
+the real feeds in backtest/dbDatafeed-1.ipynb) unless a test says otherwise.
+"""
+import os
+import sys
+import tempfile
+import threading
+
+import pandas as pd
+import pytest
+
+_TMP = tempfile.mkdtemp(prefix="etrade_test_")
+os.environ["MYM_BASE"] = _TMP
+os.environ["DATABENTO_API_KEY"] = "test-key"
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+import databento as db  # noqa: E402
+
+PX = 1_000_000_000
+
+
+def bar_price(ts: pd.Timestamp) -> float:
+    """Deterministic price for a bar opened at `ts` (quarter-point grid)."""
+    return 44000.0 + (int(ts.value // 60_000_000_000) % 400) * 0.25
+
+
+def ohlcv(ts: pd.Timestamp, bump: float = 0.0) -> db.OHLCVMsg:
+    p = bar_price(ts) + bump
+    return db.OHLCVMsg(rtype=db.RType.OHLCV_1M, publisher_id=1, instrument_id=42,
+                       ts_event=int(ts.value), open=int(p * PX), high=int((p + 1) * PX),
+                       low=int((p - 1) * PX), close=int((p + 0.5) * PX), volume=10)
+
+
+class FakeMarket:
+    """Knobs a test can turn. `now` = wall clock the fakes believe in."""
+
+    def __init__(self):
+        self.now = pd.Timestamp.now(tz="UTC")
+        self.hist_lag = pd.Timedelta(minutes=12)   # Historical edge = now - lag
+        self.metadata_raises = False
+        self.live_mode = "ok"                      # ok | error | hang | disconnect
+        self.live_bump = 0.0                       # price offset on Live bars
+        self.hist_calls, self.live_sessions = [], []
+
+    @property
+    def edge(self):
+        return self.now - self.hist_lag
+
+
+class _Store:
+    def __init__(self, df):
+        self._df = df
+
+    def to_df(self):
+        return self._df
+
+
+def make_historical(market):
+    class _Meta:
+        def get_dataset_range(self, dataset):
+            if market.metadata_raises:
+                raise RuntimeError("metadata 503")
+            e = market.edge.isoformat()
+            return {"start": "2010-06-06T00:00:00Z", "end": e,
+                    "schema": {"ohlcv-1m": {"start": "2010-06-06T00:00:00Z", "end": e}}}
+
+    class _TS:
+        def get_range(self, *, start, end, **kw):
+            start, end = pd.Timestamp(start), pd.Timestamp(end)
+            market.hist_calls.append((start, end))
+            if end > market.edge:   # mirrors Databento's 422 data_end_after_available_end
+                raise RuntimeError(f"422 end {end} after available end {market.edge}")
+            idx = pd.date_range(start.ceil("min"), end, freq="1min", inclusive="left",
+                                tz="UTC", name="ts_event")
+            px = [bar_price(t) for t in idx]
+            df = pd.DataFrame({"rtype": 33, "publisher_id": 1, "instrument_id": 42,
+                               "open": px, "high": [p + 1 for p in px],
+                               "low": [p - 1 for p in px], "close": [p + 0.5 for p in px],
+                               "volume": 10, "symbol": "MYM.v.0"}, index=idx)
+            return _Store(df)
+
+    class Historical:
+        def __init__(self, key=None):
+            self.metadata, self.timeseries = _Meta(), _TS()
+
+    return Historical
+
+
+def make_live(market):
+    class Live:
+        def __init__(self, key=None, **kw):
+            self.cb = self.exc_cb = None
+            self.start_ts = None
+            self.connected = False
+            self.stopped = self.closed = False
+            market.live_sessions.append(self)
+
+        def add_callback(self, cb, exception_callback=None):
+            self.cb, self.exc_cb = cb, exception_callback
+
+        def subscribe(self, *, dataset, schema, stype_in, symbols, start=None):
+            self.sub = dict(dataset=dataset, schema=schema, stype_in=stype_in, symbols=symbols)
+            self.start_ts = pd.Timestamp(start)
+            self.connected = True
+
+        def is_connected(self):
+            return self.connected
+
+        def _emit(self, rec):
+            try:
+                self.cb(rec)
+            except Exception as e:                      # mirrors ClientRecordCallback
+                if self.exc_cb:
+                    self.exc_cb(e)
+
+        def _run(self):
+            mode = market.live_mode
+            if mode == "error":
+                self._emit(db.ErrorMsg(ts_event=0, err="Invalid start", code=db.ErrorCode.INVALID_SUBSCRIPTION))
+                self.connected = False
+                return
+            last_closed = market.now.floor("min") - pd.Timedelta(minutes=1)
+            for ts in pd.date_range(self.start_ts.ceil("min"), last_closed, freq="1min"):
+                self._emit(ohlcv(ts, market.live_bump))
+            if mode == "disconnect":
+                self.connected = False
+                return
+            if mode == "hang":
+                return
+            self._emit(db.SystemMsg(ts_event=0, msg="Finished replay",
+                                    code=db.SystemCode.REPLAY_COMPLETED))
+
+        def start(self):
+            threading.Thread(target=self._run, daemon=True).start()
+
+        def stop(self):
+            self.stopped = True
+            self.connected = False
+
+        def block_for_close(self, timeout=None):
+            self.closed = True
+
+        def terminate(self):
+            self.closed = True
+
+    return Live
+
+
+@pytest.fixture
+def market(monkeypatch):
+    import data_feed
+    m = FakeMarket()
+    monkeypatch.setattr(data_feed.db, "Historical", make_historical(m))
+    monkeypatch.setattr(data_feed.db, "Live", make_live(m))
+    return m
