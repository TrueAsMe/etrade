+"""Bug #2 (DST-safe Render cron) and the signals-level fail-closed contract
+for bug #1."""
+import pandas as pd
+import pytest
+import pytz
+
+import config
+import signals
+
+UTC = pytz.UTC
+CRON_HOURS_UTC = range(12, 21)          # Render schedule: */4 12-20 * * 1-5
+CRON_MINUTES = range(0, 60, 4)
+
+
+def _utc(s):
+    return pd.Timestamp(s, tz="UTC").to_pydatetime()
+
+
+# ── in_run_window on both sides of the 2026-11-01 DST change ───────────────
+@pytest.mark.parametrize("utc, expected", [
+    # EDT (Fri 2026-10-30, UTC-4)
+    ("2026-10-30 11:56", False),   # 07:56 EDT
+    ("2026-10-30 12:00", True),    # 08:00 EDT
+    ("2026-10-30 19:56", True),    # 15:56 EDT
+    ("2026-10-30 20:00", False),   # 16:00 EDT
+    # EST (Mon 2026-11-02, UTC-5)
+    ("2026-11-02 12:56", False),   # 07:56 EST
+    ("2026-11-02 13:00", True),    # 08:00 EST
+    ("2026-11-02 20:56", True),    # 15:56 EST
+    ("2026-11-02 21:00", False),   # 16:00 EST
+    # weekend
+    ("2026-10-31 15:00", False),   # Sat 11:00 EDT
+    ("2026-11-01 15:00", False),   # Sun 10:00 EST
+])
+def test_in_run_window(utc, expected):
+    ok, now_et = signals.in_run_window(_utc(utc))
+    assert ok is expected, now_et
+
+
+def _slots_admitted(day):
+    """ET times of cron firings on `day` (UTC date) that pass the gate."""
+    out = []
+    for h in CRON_HOURS_UTC:
+        for m in CRON_MINUTES:
+            ok, now_et = signals.in_run_window(_utc(f"{day} {h:02d}:{m:02d}"))
+            if ok:
+                out.append(now_et.strftime("%H:%M"))
+    return out
+
+
+EXPECTED_ET_SLOTS = [f"{h:02d}:{m:02d}" for h in range(8, 16) for m in CRON_MINUTES]
+
+
+@pytest.mark.parametrize("day", pd.bdate_range("2026-03-02", "2026-03-13").strftime("%Y-%m-%d").tolist()
+                         + pd.bdate_range("2026-10-26", "2026-11-06").strftime("%Y-%m-%d").tolist())
+def test_cron_plus_gate_covers_window_exactly_across_dst(day):
+    """Every weekday around both 2026 DST changes gets all 120 runs
+    08:00-15:56 ET — no gaps, no runs outside the window."""
+    assert _slots_admitted(day) == EXPECTED_ET_SLOTS
+
+
+def test_outside_window_exits_before_any_data_pull(monkeypatch):
+    called = []
+    monkeypatch.setattr(signals, "in_run_window", lambda now=None: (False, pd.Timestamp("2026-11-02 07:56", tz="US/Eastern")))
+    monkeypatch.setattr(signals, "load_from_databento", lambda: called.append(1))
+    signals.run_signal_check()
+    assert called == []
+
+
+# ── Bug #1 at the signals layer: replay failure => no orders ───────────────
+def test_replay_failure_sends_nothing(market, monkeypatch):
+    market.live_mode = "error"
+    monkeypatch.setattr(signals, "in_run_window", lambda now=None: (True, None))
+    sent = []
+    monkeypatch.setattr(signals, "send_alert", lambda *a, **k: sent.append(a))
+    logged = []
+    monkeypatch.setattr(signals, "log", logged.append)
+    signals.run_signal_check()
+    assert sent == []
+    assert any(m.startswith("Data load failed") for m in logged)
+
+
+def test_production_call_site_returns_live_edge(market, monkeypatch):
+    """signals.load_from_databento() — the exact call Render makes, default
+    args (DATA_DAYS, cache_path=None) — yields bars to the last closed minute."""
+    monkeypatch.setattr(signals, "log", lambda m: None)
+    df_1m, df_5m, df_15m, df_1h = signals.load_from_databento()
+    assert df_1m.index[-1] == market.now.floor("min") - pd.Timedelta(minutes=1)
+    assert df_1m.index[0] >= market.now - pd.Timedelta(days=config.DATA_DAYS)
