+"""Bug #1 — signals ran on 1m bars ending at now - DATA_LAG (3h).
+
+The first three tests reproduce the production failure: they fail on the
+pre-fix data_feed.py (no Live replay on the cache_path=None path) and pass
+after it.
+"""
+import pandas as pd
+import pytest
+
+import config
+import data_feed
+from conftest import bar_price
+
+ONE_MIN = pd.Timedelta(minutes=1)
+
+
+# ── Reproduces the production bug ──────────────────────────────────────────
+def test_last_bar_is_last_closed_minute(market):
+    df_1m, *_ = data_feed.load_all_timeframes(days=1)
+    assert df_1m.index[-1] == market.now.floor("min") - ONE_MIN, (
+        f"last 1m bar {df_1m.index[-1]} lags now {market.now} — stale data")
+
+
+def test_live_replay_runs_on_production_path(market):
+    """signals.py calls load_all_timeframes() with cache_path=None."""
+    data_feed.load_all_timeframes(days=1)
+    assert len(market.live_sessions) == 1
+
+
+def test_replay_failure_fails_closed(market):
+    market.live_mode = "error"
+    with pytest.raises(data_feed.DataFeedError, match="Invalid start"):
+        data_feed.load_all_timeframes(days=1)
+
+
+# ── Stitch correctness ─────────────────────────────────────────────────────
+def test_seam_is_contiguous_without_duplicates(market):
+    df_1m, *_ = data_feed.load_all_timeframes(days=1)
+    tail = df_1m[df_1m.index >= market.edge - pd.Timedelta(hours=2)]
+    assert tail.index.is_unique
+    assert (tail.index.to_series().diff().dropna() == ONE_MIN).all()
+
+
+def test_historical_wins_on_overlap(market):
+    market.live_bump = 0.25                     # make the two sources distinguishable
+    df_1m, *_ = data_feed.load_all_timeframes(days=1)
+    edge = market.edge.floor("min")
+    overlap = df_1m[(df_1m.index >= edge - config.LIVE_REPLAY_OVERLAP) & (df_1m.index < edge)]
+    assert len(overlap) == config.LIVE_REPLAY_OVERLAP // ONE_MIN
+    assert all(row.open == bar_price(ts) for ts, row in overlap.iterrows())
+    after = df_1m[df_1m.index >= edge]
+    assert all(row.open == bar_price(ts) + 0.25 for ts, row in after.iterrows())
+
+
+def test_live_fixed_point_prices_are_scaled_exactly(market):
+    df = data_feed.pull_via_live_replay(market.now - pd.Timedelta(minutes=10), now=market.now)
+    ts = df.index[-1]
+    assert df.loc[ts, "open"] == bar_price(ts)
+    assert df.loc[ts, "close"] == bar_price(ts) + 0.5
+    assert str(df.index.tz) == "UTC" and df.index.name == "datetime"
+
+
+def test_replay_subscription_matches_config(market):
+    data_feed.load_all_timeframes(days=1)
+    s = market.live_sessions[0]
+    assert s.sub == dict(dataset=config.DATASET, schema=config.SCHEMA,
+                         stype_in=config.STYPE_IN, symbols=[config.SYMBOL])
+    assert s.start_ts == market.edge.floor("min") - config.LIVE_REPLAY_OVERLAP
+
+
+def test_resampled_frames_include_live_bars(market):
+    df_1m, df_5m, df_15m, df_1h = data_feed.load_all_timeframes(days=1)
+    for f in (df_5m, df_15m, df_1h):
+        assert f["close"].iloc[-1] == df_1m["close"].iloc[-1]   # last bin carries live bars
+
+
+# ── Historical edge ────────────────────────────────────────────────────────
+def test_historical_end_is_published_edge_floored(market):
+    assert data_feed._historical_end(market.now) == market.edge.floor("min")
+
+
+def test_historical_end_never_exceeds_now(market):
+    market.hist_lag = pd.Timedelta(minutes=-5)       # clock skew: edge in the "future"
+    assert data_feed._historical_end(market.now) == market.now.floor("min")
+
+
+def test_metadata_failure_falls_back_to_data_lag_and_still_stitches(market):
+    market.metadata_raises = True
+    market.hist_lag = config.DATA_LAG - ONE_MIN      # Historical edge just inside the fallback
+    df_1m, *_ = data_feed.load_all_timeframes(days=1)
+    hist_end = market.hist_calls[-1][1]
+    assert hist_end <= market.now - config.DATA_LAG + ONE_MIN
+    assert hist_end == hist_end.floor("min")
+    assert df_1m.index[-1] == market.now.floor("min") - ONE_MIN
+
+
+# ── Replay failure modes (all fail closed, all close the session) ──────────
+def test_replay_timeout(market):
+    market.live_mode = "hang"
+    with pytest.raises(data_feed.ReplayTimeout):
+        data_feed.pull_via_live_replay(market.now - pd.Timedelta(minutes=5),
+                                       timeout=0.5, now=market.now)
+    assert market.live_sessions[-1].stopped
+
+
+def test_replay_timeout_is_still_a_timeouterror(market):
+    """Notebook callers catch TimeoutError — keep that contract."""
+    market.live_mode = "hang"
+    with pytest.raises(TimeoutError):
+        data_feed.pull_via_live_replay(market.now - pd.Timedelta(minutes=5),
+                                       timeout=0.3, now=market.now)
+
+
+def test_disconnect_before_replay_completed(market):
+    market.live_mode = "disconnect"
+    with pytest.raises(data_feed.DataFeedError, match="closed before REPLAY_COMPLETED"):
+        data_feed.pull_via_live_replay(market.now - pd.Timedelta(minutes=5),
+                                       timeout=5, now=market.now)
+
+
+def test_gateway_error_returns_immediately_not_at_timeout(market):
+    import time
+    market.live_mode = "error"
+    t0 = time.monotonic()
+    with pytest.raises(data_feed.DataFeedError):
+        data_feed.pull_via_live_replay(market.now - pd.Timedelta(minutes=5),
+                                       timeout=20, now=market.now)
+    assert time.monotonic() - t0 < 2
+    assert market.live_sessions[-1].stopped
+
+
+def test_replay_start_beyond_24h_window_never_connects(market):
+    with pytest.raises(data_feed.DataFeedError, match="intraday-replay window"):
+        data_feed.pull_via_live_replay(market.now - pd.Timedelta(hours=24), now=market.now)
+    assert market.live_sessions == []
+
+
+def test_stale_historical_edge_fails_closed(market):
+    market.hist_lag = pd.Timedelta(hours=30)      # Historical outage
+    with pytest.raises(data_feed.DataFeedError):
+        data_feed.load_all_timeframes(days=2)
+
+
+def test_subscribe_exception_is_wrapped_and_session_closed(market, monkeypatch):
+    def boom(self, **kw):
+        raise ConnectionError("auth timed out")
+    monkeypatch.setattr(data_feed.db.Live, "subscribe", boom)
+    with pytest.raises(data_feed.DataFeedError, match="auth timed out"):
+        data_feed.pull_via_live_replay(market.now - pd.Timedelta(minutes=5), now=market.now)
+    assert market.live_sessions[-1].stopped
+
+
+def test_empty_replay_is_valid(market):
+    """Halt / maintenance break: replay completes with zero bars."""
+    df = data_feed.pull_via_live_replay(market.now.floor("min"), now=market.now)
+    assert df.empty and str(df.index.tz) == "UTC"
+
+
+# ── Research path ──────────────────────────────────────────────────────────
+def test_live_fill_false_is_historical_only(market):
+    df_1m, *_ = data_feed.load_all_timeframes(days=1, live_fill=False)
+    assert market.live_sessions == []
+    assert df_1m.index[-1] < market.edge
+
+
+def test_cache_path_incremental_stitch(market, tmp_path):
+    cache = tmp_path / "cache.csv"
+    data_feed.load_all_timeframes(days=1, cache_path=str(cache))
+    df_1m, *_ = data_feed.load_all_timeframes(days=1, cache_path=str(cache))
+    assert df_1m.index.is_unique
+    assert df_1m.index[-1] == market.now.floor("min") - ONE_MIN
